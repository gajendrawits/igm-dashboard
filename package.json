    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "css-loader": "^7.1.2",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-pino-logger": "^7.0.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^11.6.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "mongoose": "^7.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.1",
    "passport": "^0.5.2",
    "passport-jwt": "^4.0.0",
    "pino": "^8.16.0",
    "pino-http": "^8.5.0",
    "postcss-loader": "^8.1.1",
    "swagger-ui-express": "^4.6.2",
    "typescript": "^4.9.5",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
