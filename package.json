{
  "name": "igm-service-node",
  "version": "1.0.0",
  "description": "ONDC reference app IGM service",
  "main": "index.js",
  "scripts": {
    "build": "npm run tsc",
    "start": "./bin/start",
    "start:dev:server": "nodemon .",
    "start:dev:webpack": "webpack --mode=development --watch",
    "build:webpack": "webpack --mode=production",
    "build:css": "tailwindcss build -i src/style.css -o static/app.css",
    "start:prod": "node ./dist/index.js",
    "start:dev": "ts-node-dev ./index.ts",
    "dev": "NODE_ENV=development nodemon --exec 'npm run start:dev' | pino-pretty",
    "tsc": "tsc",
    "lint": "eslint \"*.ts\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run lint && npm run build && npm run test:unit && npm run test:supertest",
    "test:all": "jest",
    "test:unit": "jest \"./tests/unit/\"",
    "test:supertest": "jest \"./tests/integration/\"",
    "postinstall": "husky install"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/mime": "^3.0.1",
    "apexcharts": "^4.5.0",
    "aws-sdk": "^2.1547.0",
    "axios": "^1.3.5",
