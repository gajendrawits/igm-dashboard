<!---
title: Tailwind CSS Products Page - Flowbite
description: Get started with a free and open-source admin dashboard layout built with Tailwind CSS and Flowbite featuring charts, widgets, CRUD layouts, authentication pages, and more
layout: dashboard
group: crud
--->

<div class="p-4 bg-white block sm:flex items-center justify-between border-b border-gray-200 lg:mt-1.5 dark:bg-gray-800 dark:border-gray-700">
    <div class="w-full mb-1">
        <div class="mb-4">
            <nav class="flex mb-5" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2">
                  <li class="inline-flex items-center">
                    <a href="#" class="inline-flex items-center text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-white">
                      <svg class="w-5 h-5 mr-2.5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
                      Home
                    </a>
                  </li>
                  <li>
                    <div class="flex items-center">
                      <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
                      <a href="#" class="ml-1 text-gray-700 hover:text-primary-600 md:ml-2 dark:text-gray-300 dark:hover:text-white">Issues</a>
                    </div>
                  </li>
                </ol>
            </nav>
            <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">Issues</h1>
        </div>
        <div class="items-center justify-between block sm:flex dark:divide-gray-700">
            <div class="flex items-center gap-4 mb-4 sm:mb-0">
                <form class="sm:pr-3 flex gap-4" action="/dashboard/issue-id" method="POST">
                    <label for="products-search" class="sr-only">Search</label>
                    <div class="relative w-48 mt-1 sm:w-64 xl:w-96">
                        <input type="text" name="issueId" id="products-search" class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" placeholder="Search Issue ID">
                    </div>
                    <button id="createProductButton" class="text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2 dark:bg-primary-600 dark:hover:bg-primary-700 focus:outline-none dark:focus:ring-primary-800" type="submit" data-drawer-target="drawer-create-product-default" data-drawer-show="drawer-create-product-default" aria-controls="drawer-create-product-default" data-drawer-placement="right">
                        Search
                    </button>
                </form>                
            </div>
            <div class="items-center sm:flex">
                <div date-rangepicker class="flex items-center space-x-4">
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                      <svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M5.25 12a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H6a.75.75 0 01-.75-.75V12zM6 13.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V14a.75.75 0 00-.75-.75H6zM7.25 12a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H8a.75.75 0 01-.75-.75V12zM8 13.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V14a.75.75 0 00-.75-.75H8zM9.25 10a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H10a.75.75 0 01-.75-.75V10zM10 11.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V12a.75.75 0 00-.75-.75H10zM9.25 14a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H10a.75.75 0 01-.75-.75V14zM12 9.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V10a.75.75 0 00-.75-.75H12zM11.25 12a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H12a.75.75 0 01-.75-.75V12zM12 13.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V14a.75.75 0 00-.75-.75H12zM13.25 10a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H14a.75.75 0 01-.75-.75V10zM14 11.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V12a.75.75 0 00-.75-.75H14z"></path>
                        <path clip-rule="evenodd" fill-rule="evenodd" d="M5.75 2a.75.75 0 01.75.75V4h7V2.75a.75.75 0 011.5 0V4h.25A2.75 2.75 0 0118 6.75v8.5A2.75 2.75 0 0115.25 18H4.75A2.75 2.75 0 012 15.25v-8.5A2.75 2.75 0 014.75 4H5V2.75A.75.75 0 015.75 2zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75z"></path>
                      </svg>
                    </div>
                    <input name="start" type="text" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full pl-10 p-2.5  dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" placeholder="From">
                  </div>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                      <svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M5.25 12a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H6a.75.75 0 01-.75-.75V12zM6 13.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V14a.75.75 0 00-.75-.75H6zM7.25 12a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H8a.75.75 0 01-.75-.75V12zM8 13.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V14a.75.75 0 00-.75-.75H8zM9.25 10a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H10a.75.75 0 01-.75-.75V10zM10 11.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V12a.75.75 0 00-.75-.75H10zM9.25 14a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H10a.75.75 0 01-.75-.75V14zM12 9.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V10a.75.75 0 00-.75-.75H12zM11.25 12a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H12a.75.75 0 01-.75-.75V12zM12 13.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V14a.75.75 0 00-.75-.75H12zM13.25 10a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H14a.75.75 0 01-.75-.75V10zM14 11.25a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 00.75-.75V12a.75.75 0 00-.75-.75H14z"></path>
                        <path clip-rule="evenodd" fill-rule="evenodd" d="M5.75 2a.75.75 0 01.75.75V4h7V2.75a.75.75 0 011.5 0V4h.25A2.75 2.75 0 0118 6.75v8.5A2.75 2.75 0 0115.25 18H4.75A2.75 2.75 0 012 15.25v-8.5A2.75 2.75 0 014.75 4H5V2.75A.75.75 0 015.75 2zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75z"></path>
                      </svg>
                    </div>
                    <input name="end" type="text" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full pl-10 p-2.5  dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" placeholder="To">
                  </div>
                </div>
            </div>            
        </div>
    </div>
</div>
<div class="flex flex-col">
    <div class="overflow-x-auto">
        <div class="inline-block min-w-full align-middle">
            <div class="overflow-hidden shadow">
                <table class="min-w-full divide-y divide-gray-200 table-fixed dark:divide-gray-600">
                    <thead class="bg-gray-100 dark:bg-gray-700">
                        <tr>
                            <th scope="col" class="p-4">
                                <div class="flex items-center">
                                    <input id="checkbox-all" aria-describedby="checkbox-1" type="checkbox" class="w-4 h-4 border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-primary-300 dark:focus:ring-primary-600 dark:ring-offset-gray-800 dark:bg-gray-700 dark:border-gray-600">
                                    <label for="checkbox-all" class="sr-only">checkbox</label>
                                </div>
                            </th>
                            <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">
                                Bpp Id
                            </th>
                            <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">
                                Category
                            </th>
                            <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">
                                Domain
                            </th>
                            <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">
                                Issue ID
                            </th>
                            <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">
                                Sub Category
                            </th>
                            <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">
                                Issue Status
                            </th>
                            <th scope="col" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                        <% const response = JSON.parse(issues); %>
                        <% const issuesArray = response.issues; %>
                        <% for (let i = 0; i < issuesArray.length; i++) { %>
                            <% const issue = issuesArray[i]; %>                            

                        <tr class="hover:bg-gray-100 dark:hover:bg-gray-700">
                            <td class="w-4 p-4">
                                <div class="flex items-center">
                                    <input id="checkbox-<%= issue._id %>" aria-describedby="checkbox-1" type="checkbox"
                                        class="w-4 h-4 border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-primary-300 dark:focus:ring-primary-600 dark:ring-offset-gray-800 dark:bg-gray-700 dark:border-gray-600">
                                    <label for="checkbox-<%= issue._id %>" class="sr-only">checkbox</label>
                                </div>
                            </td>

                            <td class="p-4 text-base font-medium text-gray-900 whitespace-nowrap dark:text-white"><%= issue.bppId %></td>
                            <td class="p-4 text-base font-medium text-gray-900 whitespace-nowrap dark:text-white"><%= issue.category %></td>
                            <td class="p-4 text-base font-medium text-gray-900 whitespace-nowrap dark:text-white"><%= issue.domain %></td>
                            <td class="p-4 text-base font-medium text-gray-900 whitespace-nowrap dark:text-white"><%= issue.issueId %></td>
                            <td class="p-4 text-base font-medium text-gray-900 whitespace-nowrap dark:text-white"><%= issue.sub_category %></td>
                            <td class="p-4 text-base font-medium text-gray-900 whitespace-nowrap dark:text-white"><%= issue.issue_status %></td>

                            <td class="p-4 space-x-2 whitespace-nowrap">
                                <button type="button" 
                                        onclick="openIssueDrawer('<%= issue._id %>')"
                                        data-issue='<%= JSON.stringify(issue) %>'
                                        class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white rounded-lg bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
                                    Actions
                                </button>
                                <button type="button" 
                                        onclick="openFetchStatusDrawer('<%= issue._id %>')"
                                        data-issue='<%= JSON.stringify(issue) %>'
                                        class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white rounded-lg bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
                                    Fetch Status
                                </button>
                            </td>
                        </tr>

                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<% const current = parseInt(currentPage); %>
<% const totalPages = Math.ceil(totalCount / limit); %>
<% const prevPage = current > 1 ? current - 1 : 1; %>
<% const nextPage = current < totalPages ? current + 1 : totalPages; %>

<div class="sticky bottom-0 right-0 items-center w-full p-4 bg-white border-t border-gray-200 sm:flex sm:justify-between dark:bg-gray-800 dark:border-gray-700">
    <div class="flex items-center mb-4 sm:mb-0">
        <!-- Previous Page -->
        <a href="?pageNumber=<%= prevPage %>&limit=<%= limit %>" 
           class="inline-flex justify-center p-1 text-gray-500 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:hover:bg-gray-700 dark:hover:text-white">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
        </a>

        <!-- Next Page -->
        <a href="?pageNumber=<%= nextPage %>&limit=<%= limit %>" 
           class="inline-flex justify-center p-1 mr-2 text-gray-500 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:hover:bg-gray-700 dark:hover:text-white">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
        </a>

        <span class="text-sm font-normal text-gray-500 dark:text-gray-400">
            Showing 
            <span class="font-semibold text-gray-900 dark:text-white">
                <%= (current - 1) * limit + 1 %> - 
                <%= Math.min(current * limit, totalCount) %>
            </span> of 
            <span class="font-semibold text-gray-900 dark:text-white"><%= totalCount %></span>
        </span>
    </div>
</div>

<!-- Actions Drawer -->
<div id="drawer-update-product-default" class="fixed top-0 right-0 z-40 w-full h-screen max-w-xs p-4 overflow-y-auto transition-transform translate-x-full bg-white dark:bg-gray-800" tabindex="-1">
    <h5 class="inline-flex items-center mb-6 text-sm font-semibold text-gray-500 uppercase dark:text-gray-400">Action Taken</h5>
    <button type="button" onclick="closeDrawer('drawer-update-product-default')" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 absolute top-2.5 right-2.5 inline-flex items-center dark:hover:bg-gray-600 dark:hover:text-white">
        <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
        <span class="sr-only">Close menu</span>
    </button>
    <div id="drawer-content" class="space-y-4">
        <!-- Dynamic content will be inserted here -->
    </div>
</div>

<!-- Fetch Status Drawer -->
<div id="drawer-fetch-status-default" class="fixed top-0 right-0 z-40 w-full h-screen max-w-xs p-4 overflow-y-auto transition-transform translate-x-full bg-white dark:bg-gray-800" tabindex="-1">
    <h5 class="inline-flex items-center mb-6 text-sm font-semibold text-gray-500 uppercase dark:text-gray-400">Fetch Status</h5>
    <button type="button" onclick="closeDrawer('drawer-fetch-status-default')" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 absolute top-2.5 right-2.5 inline-flex items-center dark:hover:bg-gray-600 dark:hover:text-white">
        <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
        <span class="sr-only">Close menu</span>
    </button>
    <div id="fetch-status-content" class="space-y-4">
        <!-- Dynamic content will be inserted here -->
    </div>
</div>

<!-- Backdrop (shared between both drawers) -->
<div id="drawer-backdrop" class="fixed inset-0 z-30 hidden bg-gray-900 bg-opacity-50 dark:bg-opacity-80"></div>

<script>
    let currentIssue = null;
    
    // Open Actions Drawer
    function openIssueDrawer(issueId) {
        const button = document.querySelector(`button[data-issue][onclick*="openIssueDrawer('${issueId}')"]`);
        currentIssue = JSON.parse(button.getAttribute('data-issue'));
        
        const drawer = document.getElementById('drawer-update-product-default');
        const content = document.getElementById('drawer-content');
        const backdrop = document.getElementById('drawer-backdrop');
        
        content.innerHTML = `            
            <div class="mb-6">
                <div class="space-y-4">
                    ${(() => {
                        const actions = [
                            ...currentIssue.issue_actions.complainant_actions, 
                            ...currentIssue.issue_actions.respondent_actions
                        ].sort((a, b) => new Date(a.updated_at) - new Date(b.updated_at));
                        
                        return actions.map(action => `
                            <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg dark:bg-gray-700 dark:border-gray-600">
                                <div>
                                    <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Action:</span>
                                    <p class="text-sm text-gray-900 dark:text-white">${action.complainant_action || action.respondent_action || 'N/A'}</p>
                                </div> 
                                <div class="mb-2">
                                    <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Description:</span>
                                    <p class="text-sm text-gray-900 dark:text-white">${action.short_desc || 'N/A'}</p>
                                </div>
                                <div>
                                    <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Updated by:</span>
                                    <p class="text-sm text-gray-900 dark:text-white">${action.updated_by?.org?.name || 'N/A'}</p>
                                </div>
                                <div>
                                    <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Updated at:</span>
                                    <p class="text-sm text-gray-900 dark:text-white">${new Date(action.updated_at).toLocaleString('en-IN', { hour12: true })}</p>
                                </div>                                
                            </div>
                        `).join('');
                    })()}
                </div>
            </div>          
        `;
        
        showDrawer('drawer-update-product-default');
    }
    
    // Open Fetch Status Drawer
    function openFetchStatusDrawer(issueId) {
        const button = document.querySelector(`button[data-issue][onclick*="openFetchStatusDrawer('${issueId}')"]`);
        currentIssue = JSON.parse(button.getAttribute('data-issue'));
        
        const content = document.getElementById('fetch-status-content');
        
        content.innerHTML = `
            <div class="mb-4">
                <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Current Status</label>
                <div id="current-status-display" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                    ${currentIssue.issue_status || 'N/A'}
                </div>
            </div>
            <div class="mb-4">
                <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Last Action Time</label>
                <div id="last-action-time-display" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                    ${(() => {
                        const actions = [
                            ...currentIssue.issue_actions.complainant_actions, 
                            ...currentIssue.issue_actions.respondent_actions
                        ].sort((a, b) => new Date(b.updated_at) - new Date(a.updated_at));
                        
                        const mostRecentUpdate = actions.length > 0 ? actions[0].updated_at : null;
                        return mostRecentUpdate ? new Date(mostRecentUpdate).toLocaleString('en-IN', { hour12: true }) : 'N/A';
                    })()}
                </div>
            </div>
            <div class="mt-6">
                <button type="button" id="refresh-status-btn" onclick="fetchLatestStatus('${currentIssue._id}')" class="w-full px-3 py-2 text-sm font-medium text-center text-white rounded-lg bg-green-600 hover:bg-green-700 focus:ring-4 focus:ring-green-300 dark:bg-green-500 dark:hover:bg-green-600 dark:focus:ring-green-800">
                    Refresh Status
                </button>
                <div id="refresh-status-loading" class="hidden mt-2 text-center">
                    <div role="status">
                        <svg aria-hidden="true" class="inline w-6 h-6 text-gray-200 animate-spin dark:text-gray-600 fill-blue-600" viewBox="0 0 100 101" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" fill="currentColor"/>
                            <path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/>
                        </svg>
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Fetching latest status...</p>
                </div>
            </div>
        `;
        
        showDrawer('drawer-fetch-status-default');
    }
    
    // Shared drawer functions
    function showDrawer(drawerId) {
        document.getElementById(drawerId).classList.remove('translate-x-full');
        document.getElementById('drawer-backdrop').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }
    
    function closeDrawer(drawerId) {
        document.getElementById(drawerId).classList.add('translate-x-full');
        document.getElementById('drawer-backdrop').classList.add('hidden');
        document.body.style.overflow = '';
    }
    
    // Close when clicking backdrop
    document.getElementById('drawer-backdrop').addEventListener('click', () => {
        closeDrawer('drawer-update-product-default');
        closeDrawer('drawer-fetch-status-default');
    });
    
    // Close with Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeDrawer('drawer-update-product-default');
            closeDrawer('drawer-fetch-status-default');
        }
    });
    
    // Fetch latest status from API
    async function fetchLatestStatus(issueId) {
        const refreshBtn = document.getElementById('refresh-status-btn');
        const loadingIndicator = document.getElementById('refresh-status-loading');
        
        // Show loading state
        refreshBtn.classList.add('hidden');
        loadingIndicator.classList.remove('hidden');
        
        try {
            // Replace this URL with your actual API endpoint
            const response = await fetch(`/api/issues/${issueId}/status`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    // Add any authentication headers if needed
                    // 'Authorization': 'Bearer YOUR_TOKEN'
                }
            });
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            
            document.getElementById('current-status-display').textContent = data.issue_status || 'N/A';
            
            const actions = [
                ...data.issue_actions.complainant_actions, 
                ...data.issue_actions.respondent_actions
            ].sort((a, b) => new Date(b.updated_at) - new Date(a.updated_at));
            
            const mostRecentUpdate = actions.length > 0 ? actions[0].updated_at : null;
            document.getElementById('last-action-time-display').textContent = 
                mostRecentUpdate ? new Date(mostRecentUpdate).toLocaleString('en-IN', { hour12: true }) : 'N/A';
            
            currentIssue = data;
            
            const button = document.querySelector(`button[data-issue][onclick*="openFetchStatusDrawer('${issueId}')"]`);
            if (button) {
                button.setAttribute('data-issue', JSON.stringify(data));
            }
            
        } catch (error) {
            console.error('Error fetching status:', error);
            alert('Failed to fetch latest status. Please try again.');
        } finally {
            refreshBtn.classList.remove('hidden');
            loadingIndicator.classList.add('hidden');
        }
    }
</script>